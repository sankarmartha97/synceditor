# ===========================================
# Canvas Editor - Environment Variables
# ===========================================
# Copy this file to .env and update values

# ===========================================
# BACKEND CONFIGURATION
# ===========================================

# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://canvas_user:canvas_pass@localhost:5432/canvas_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canvas_db
DB_USER=canvas_user
DB_PASSWORD=canvas_pass

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345678
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# DOCKER CONFIGURATION
# ===========================================

# PostgreSQL (for docker-compose)
POSTGRES_USER=canvas_user
POSTGRES_PASSWORD=canvas_pass
POSTGRES_DB=canvas_db

# ===========================================
# FRONTEND CONFIGURATION (Future)
# ===========================================

# API URLs
API_URL=http://localhost:5000
WS_URL=ws://localhost:5000

# ===========================================
# PRODUCTION NOTES
# ===========================================
# 
# For production deployment:
# 1. Set NODE_ENV=production
# 2. Use strong JWT_SECRET (64+ characters)
# 3. Use proper database credentials
# 4. Configure ALLOWED_ORIGINS for your domain
# 5. Enable HTTPS for API_URL and WS_URL
# 6. Set proper rate limits
# 
# ===========================================
